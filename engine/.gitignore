node_modules/
dist/
.DS_Store
*.log

# engine/docs/ is not a home for developer documentation: docs/reference/ ships with the package,
# and check-docs-guard.mjs refuses any other tracked file there. Durable docs live at the
# repository root or in docs/.
docs/*
!docs/reference/

notes/*

# Local environment
.env
.env.local
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite.pre-reboot-backup
.loom/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/developing-loom/
# A launch provisions this file into the seat's own cwd, so a seat that sits inside this
# repo (demo/team) writes one too; the rules above only cover the engine root.
**/.claude/settings.local.json
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/developing-loom/
.loom
.worktrees/

# Local demo proof artifacts
demo/proof/

# Build artifacts
*.tgz

# Internal build receipts; never commit
/.evidence/

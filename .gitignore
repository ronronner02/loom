# spec-first:start
# host-local scratch and settings
.claude/tasks/
.claude/worktrees/
.qoder/settings.local.json

# spec-first local setup and workflow runtime artifacts
.spec-first/*.local.yaml
.spec-first/config.local.yaml
.spec-first/config/*.json
.spec-first/audits/
.spec-first/governance/
.spec-first/app-audit/
.spec-first/workflows/
.spec-first/workspace/
.spec-first/sessions/

# optional provider local artifacts
.codegraph/
graphify-out/
.graphify/
# spec-first:end

# desktop app build output and dependencies
desktop/dist/
desktop/node_modules/

# desktop installer staging: generated from the engine build by npm run stage, never committed
desktop/resources/
desktop/.cache/

# oil-ui design workspace: local process files, never part of a delivery
.oil-ui/

# A checkout installs its dependencies at the root as often as inside a package.
/node_modules/
.DS_Store
Thumbs.db

# Logs and local probe scripts never belong in a commit.
*.log
*.err
*.out
/tmp-*
/_*.sh
/_*.py
/_*.ps1
/_*.md

# Local scratch folders that are not product paths.
/output/
/reference/
/cache/

# Host runtime mirrors: spec-first init writes these per machine and they are never shared.
/.agents/
/.claude/
/.codex/
/.opencode/
/.pi/

# Root docs are fully tracked, so a scratch note needs an explicit rule to stay out.
/docs/scratch/
/docs/notes/
